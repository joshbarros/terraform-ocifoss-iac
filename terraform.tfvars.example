# Example terraform.tfvars file - Copy to terraform.tfvars and update values

# OCI Authentication
tenancy_ocid = "ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
user_ocid = "ocid1.user.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
fingerprint = "xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx"
private_key_path = "~/.oci/oci_api_key.pem"
region = "sa-saopaulo-1"

# SSH Configuration
ssh_public_key = "ssh-rsa YOUR_PUBLIC_KEY_HERE"

# Budget Configuration
budget_amount = 250
budget_email = "your-email@example.com"

# Instance Configuration
instance_shape = "VM.Standard.E2.8"
boot_volume_size = 50
data_volume_size = 16384
data_volume_vpus_per_gb = 20

# Network Configuration
vcn_cidr = "10.0.0.0/16"
subnet_cidr = "10.0.1.0/24"

# Email for alerts
alert_email = "your-email@example.com" 